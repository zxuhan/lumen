# Copy to .env in the repo root (not backend/): cp .env.example .env
# .env is gitignored; never commit it.

# development | production (production marks the sign-in cookie Secure, so it needs HTTPS)
APP_ENV=development
API_PORT=7302

# Postgres and Redis from docker-compose
DATABASE_URL=postgresql+asyncpg://retouch:retouch_dev@localhost:7311/retouch
REDIS_URL=redis://localhost:7312

# Object storage. The defaults are the local MinIO; for Cloudflare R2 use
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#     (EU-jurisdiction buckets: https://<account-id>.eu.r2.cloudflarestorage.com)
#   S3_REGION=auto
# plus the bucket name and the keys of an Object Read & Write token for that bucket
S3_ENDPOINT=http://localhost:7313
# Address browsers use to open signed URLs; empty means the same as S3_ENDPOINT
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=retouch
S3_ACCESS_KEY=retouch
S3_SECRET_KEY=retouch_dev
# Signed URL lifetime, in seconds
S3_URL_TTL=900

# HS256 needs at least 32 bytes; for production generate one with: openssl rand -hex 32
JWT_SECRET=dev-only-secret-please-change-in-production
JWT_TTL_HOURS=24

# mock: free placeholder images | openai: real images. Chat planning needs OPENAI_API_KEY either way
IMAGE_PROVIDER=mock
OPENAI_API_KEY=
# https://eu.api.openai.com/v1 for a project created with EU data residency
OPENAI_BASE_URL=https://api.openai.com/v1
PLANNER_MODEL=gpt-5-mini
# minimal | low | medium | high for reasoning models; empty for models without reasoning
PLANNER_REASONING=low
# gpt-image-2 (best, any size) | gpt-image-1-mini (cheapest, 3 fixed sizes)
IMAGE_MODEL=gpt-image-2
# low | medium | high; each step costs roughly 4x the one before
IMAGE_QUALITY=medium

# auto: rembg if installed, otherwise corner-color matting | rembg | corner
MATTING_PROVIDER=auto
# auto: detect text layers if rapidocr is installed | rapidocr | none
OCR_PROVIDER=auto
