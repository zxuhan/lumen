vars: {
  d2-config: {
    pad: 16
  }
}

direction: down

classes: {
  state: {
    shape: rectangle
    style: {
      fill: "#FFF7ED"
      stroke: "#C2410C"
      stroke-width: 2
      font-color: "#1F2937"
      border-radius: 6
    }
    height: 42
    width: 140
  }
  pseudo: {
    shape: circle
    width: 20
    height: 20
    style: {
      fill: "#1F2937"
      stroke: "#1F2937"
    }
  }
}

start: "" {class: pseudo}
end: "" {
  class: pseudo
  style: {
    fill: "#FFFFFF"
    stroke-width: 2
    double-border: true
  }
}

queued: "queued" {class: state}
running: "running" {class: state}
succeeded: "succeeded" {class: state}
failed: "failed" {class: state}
canceled: "canceled" {class: state}

start -> queued: "multi-step plan"
start -> running: "single step"
start -> failed: "planner error"
queued -> running: "confirm"
queued -> canceled: "cancel"
running -> succeeded: "all steps done"
running -> failed: "a step failed"
running -> canceled: "cancel remaining"
failed -> running: "retry step"
succeeded -> end
canceled -> end
